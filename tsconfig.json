{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // ES2015 + CommonJS keeps the package usable from Node >= 12 and old bundlers.
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist/",
    "declaration": true,

    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
