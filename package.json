{
  "private": false,
  "name": "@zootools/email-spell-checker",
  "version": "1.13.0",
  "description": "mailSpellChecker.js (mail spell checker) is a lightweight module that suggests a right domain when your users misspell it in an email address",
  "main": "./dist/index.js",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf ./dist/",
    "cm": "cz",
    "lint": "eslint . --fix",
    "prepare": "husky",
    "release": "npm run test && npm install && npm run build && npm publish",
    "semantic-release": "semantic-release",
    "test:watch": "jest --watch",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashsend/email-spell-checker.git"
  },
  "license": "MIT",
  "author": {
    "name": "SmashSend",
    "email": "help@smashsend.com",
    "url": "https://smashsend.com"
  },
  "engines": {
    "node": ">=12.0"
  },
  "keywords": [
    "spellcheck",
    "email",
    "email marketing",
    "email validation",
    "spelling",
    "spelling checker",
    "email verification",
    "spelling correction",
    "spellchecker"
  ],
  "bugs": {
    "url": "https://github.com/smashsend/email-spell-checker/issues"
  },
  "homepage": "https://smashsend.com/tools/email-spell-checker",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ryansonshine/commitizen": "4.2.8",
    "@ryansonshine/cz-conventional-changelog": "^3.3.4",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "12.20.11",
    "@types/trim": "0.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "ts-node": "10.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/@ryansonshine/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "eslint --cache --fix",
    "*.{json,md,yml}": "prettier --write"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "build",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "build",
                "section": "Dependencies and Other Build Updates",
                "hidden": false
              }
            ]
          }
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "overrides": {
    "glob@>=9.0.0": "^14.0.6",
    "minimatch@>=7.0.0": "^11.0.8"
  }
}
